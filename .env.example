# ── Required ──────────────────────────────────────────────────────────────────
# OpenRouter API key — gives access to all four AI models via one key.
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-12321aadfsdfsadfsd

# ── Family access ─────────────────────────────────────────────────────────────
FAMILY_INVITE_CODE=family2024

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# ── AI Models — Four layers, all via OpenRouter ───────────────────────────────

# Layer 1: Hermes 3 (Llama-3.1 8B) — fast extraction for short text
EXTRACT_MODEL=nousresearch/hermes-3-llama-3.1-8b

# Layer 2: Mistral Small 4 (24B) — deep extraction for long docs/transcripts
EXTRACT_LONG_MODEL=mistralai/mistral-small-3.1-24b-instruct
EXTRACT_LONG_THRESHOLD=1500

# Layer 3: Nous-Hermes-2-Mixtral-8x7B — standard Hermes agent queries
QUERY_MODEL=nousresearch/nous-hermes-2-mixtral-8x7b-dpo

# Layer 4: Kimi K2 Thinking — complex multi-hop reasoning (auto-escalation fallback)
QUERY_DEEP_MODEL=moonshotai/kimi-k2
FORCE_DEEP_QUERY=false

# ── Audio transcription ───────────────────────────────────────────────────────
WHISPER_MODEL=tiny.en
ENABLE_TRANSCRIPTION=true

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=./data
DB_PATH=./data/decisions.db
GRAPH_PATH=./data/graph.kuzu
VECTOR_DIR=./data/vectors
UPLOAD_DIR=./data/uploads
